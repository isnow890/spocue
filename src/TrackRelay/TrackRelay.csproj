<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <AssemblyName>SpoCue</AssemblyName>
    <ApplicationIcon>Assets/SpoCue.ico</ApplicationIcon>
    <Version>0.5.1</Version>
    <DefineConstants Condition="'$(StoreBuild)' == 'true'">$(DefineConstants);STORE_BUILD</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="Assets/SpoCue.ico" />
    <None Include="../../LICENSE" Link="LICENSE" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
