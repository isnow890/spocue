<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <SolidColorBrush x:Key="CanvasBrush" Color="#101318" />
  <SolidColorBrush x:Key="SurfaceBrush" Color="#191E26" />
  <SolidColorBrush x:Key="InkBrush" Color="#F2F4F8" />
  <SolidColorBrush x:Key="MutedBrush" Color="#A9B4C3" />
  <SolidColorBrush x:Key="BorderBrush" Color="#343E4C" />
  <SolidColorBrush x:Key="AccentBrush" Color="#FFCA83" />
  <SolidColorBrush x:Key="AccentTextBrush" Color="#231508" />
  <SolidColorBrush x:Key="AccentSoftBrush" Color="#3D2B21" />
  <SolidColorBrush x:Key="ErrorBrush" Color="#FFADAA" />
  <FontFamily x:Key="BodyFont">Segoe UI</FontFamily>
  <FontFamily x:Key="DisplayFont">Bahnschrift, Segoe UI</FontFamily>

  <Style TargetType="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
  </Style>
  <Style x:Key="SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
    <Setter Property="FontSize" Value="19" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="AutomationProperties.HeadingLevel" Value="Level2" />
  </Style>
  <Style x:Key="ActionButton" TargetType="Button">
    <Setter Property="MinHeight" Value="36" />
    <Setter Property="Padding" Value="14,6" />
    <Setter Property="Background" Value="{DynamicResource SurfaceBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
              <Setter TargetName="Frame" Property="Opacity" Value="0.90" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Frame" Property="Opacity" Value="0.75" />
            </Trigger>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource InkBrush}" />
              <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
              <Setter TargetName="Frame" Property="Padding" Value="13,5" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Frame" Property="Opacity" Value="0.55" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>
  <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ActionButton}">
    <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
</ResourceDictionary>
