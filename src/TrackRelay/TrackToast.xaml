<Window x:Class="TrackRelay.TrackToast" x:ClassModifier="internal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TrackRelay"
        Title="{DynamicResource NotificationTitle}" Width="360" Height="96" ShowActivated="False" ShowInTaskbar="False"
        Topmost="True" WindowStyle="None" ResizeMode="NoResize" Background="Transparent"
        AllowsTransparency="True" Focusable="False" FontFamily="{StaticResource BodyFont}"
        UseLayoutRounding="True">
  <Button x:Name="OpenSpotifyButton" AutomationProperties.Name="{DynamicResource OpenSpotify}"
          ToolTip="{DynamicResource ToastTooltip}" Click="OpenSpotifyClick"
          MouseRightButtonUp="CopyTrackRightClick" Focusable="False">
    <Button.Template>
      <ControlTemplate TargetType="Button">
        <ContentPresenter />
      </ControlTemplate>
    </Button.Template>
    <Button.Style>
      <Style TargetType="Button">
        <Style.Triggers>
          <Trigger Property="IsEnabled" Value="True">
            <Setter Property="Cursor" Value="Hand" />
          </Trigger>
        </Style.Triggers>
      </Style>
    </Button.Style>
    <Border x:Name="ToastFrame" Background="{DynamicResource SurfaceBrush}"
            BorderThickness="1" CornerRadius="12">
      <Border.Style>
        <Style TargetType="Border">
          <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}" />
          <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
          </Style.Triggers>
        </Style>
      </Border.Style>
      <Grid Margin="13,12,16,12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <local:ArtworkBadge x:Name="Cover" Width="62" Height="62" />
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
          <TextBlock x:Name="TrackTitle" FontFamily="{StaticResource DisplayFont}" FontSize="14"
                     FontWeight="SemiBold" LineHeight="18" LineStackingStrategy="BlockLineHeight"
                     MaxHeight="36" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" />
          <TextBlock x:Name="TrackSubtitle" Foreground="{DynamicResource MutedBrush}" FontSize="12"
                     Margin="0,3,0,0" TextTrimming="CharacterEllipsis" />
          <Grid x:Name="VolumeMeter" Height="4" Margin="0,8,0,0" Visibility="Collapsed">
            <Grid.ColumnDefinitions>
              <ColumnDefinition x:Name="VolumeFilled" Width="0*" />
              <ColumnDefinition x:Name="VolumeRemaining" Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.ColumnSpan="2" CornerRadius="2" Background="{DynamicResource BorderBrush}" />
            <Border CornerRadius="2" Background="{DynamicResource AccentBrush}" />
          </Grid>
        </StackPanel>
      </Grid>
    </Border>
  </Button>
</Window>
